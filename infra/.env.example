POSTGRES_DB=clubes_db
POSTGRES_USER=clubes
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Base de datos y rol dedicados de Keycloak (misma instancia PostgreSQL, datos aislados)
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-unique-local-password

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-unique-local-password

PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-unique-local-password
