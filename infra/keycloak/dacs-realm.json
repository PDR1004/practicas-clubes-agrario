{
  "realm": "dacs",
  "enabled": true,
  "displayName": "Club Agrario Rocamora - DACS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "SUPERADMIN",
        "description": "Administrador global de la Liga"
      },
      {
        "name": "ADMIN_CLUB",
        "description": "Administrador de Club"
      },
      {
        "name": "TESORERO",
        "description": "Tesorero del Club"
      },
      {
        "name": "DELEGADO",
        "description": "Delegado de categoria del Club"
      },
      {
        "name": "ENTRENADOR",
        "description": "Entrenador de categoria del Club"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dacs-fe",
      "name": "DACS Frontend (React)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "https://clubes.local",
      "baseUrl": "/dacs/",
      "redirectUris": [
        "https://clubes.local/*",
        "http://localhost:5173/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "https://clubes.local",
        "http://localhost:5173",
        "http://localhost",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "id_club-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id_club",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "id_club",
            "jsonType.label": "int"
          }
        },
        {
          "name": "id_liga-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id_liga",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "id_liga",
            "jsonType.label": "int"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Super",
      "lastName": "Admin",
      "email": "superadmin@clubes.local",
      "attributes": {
        "id_liga": [
          "1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dacs",
        "SUPERADMIN"
      ]
    },
    {
      "username": "admin-club",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Club",
      "email": "admin.club@clubes.local",
      "attributes": {
        "id_club": [
          "1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dacs",
        "ADMIN_CLUB"
      ]
    },
    {
      "username": "tesorero",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tesorero",
      "lastName": "Club",
      "email": "tesorero@clubes.local",
      "attributes": {
        "id_club": [
          "1"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dacs",
        "TESORERO"
      ]
    },
    {
      "username": "delegado",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Delegado",
      "lastName": "Categoria",
      "email": "delegado@clubes.local",
      "attributes": {
