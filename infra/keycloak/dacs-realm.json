{
  "realm": "dacs",
  "enabled": true,
  "displayName": "Mayorista Del Puerto - DACS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "ROLE-A",
        "description": "Operador de Deposito (ABM Productos, Recepciones y Egresos)"
      },
      {
        "name": "ROLE-B",
        "description": "Supervisor / Auditor (Consulta de Stock, Lotes FEFO y Alertas)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dacs-fe",
      "name": "Mayorista Del Puerto Frontend (Angular)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "https://clubes.local",
      "baseUrl": "/dacs/",
      "redirectUris": [
        "https://clubes.local/*",
        "http://localhost:4200/*",
        "http://localhost/*"
      ],
      "webOrigins": [
        "https://clubes.local",
        "http://localhost:4200",
        "http://localhost",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ],
  "users": [
    {
      "username": "user-a",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Operador",
      "lastName": "Deposito",
      "email": "operador@delpuerto.local",
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dacs",
        "ROLE-A"
      ]
    },
    {
      "username": "user-b",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Supervisor",
      "lastName": "Auditoria",
      "email": "supervisor@delpuerto.local",
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dacs",
        "ROLE-B"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Del Puerto",
      "email": "admin@delpuerto.local",
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dacs",
        "ROLE-A",
        "ROLE-B"
      ]
    }
  ]
}
